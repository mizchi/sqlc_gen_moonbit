// Generated by sqlc-gen-moonbit (backend: d1)
// Requires: mizchi/cloudflare

///| Read a required (NOT NULL) column from a D1 result row.
/// Aborts the request with a clear message if the cell is
/// null or missing — surfacing the bad row at the read site
/// instead of letting `undefined` propagate through `cast()`
/// into a MoonBit value.
fn d1_require_field(row : @core.Any, field : String) -> @core.Any {
  let value = row[field]
  if @core.is_null(value) || @core.typeof_(value) == "undefined" {
    abort("D1 row missing required column \"" + field + "\"")
  }
  value
}

///| Convert MoonBit Int64 params to a JavaScript Number before
/// binding. Cloudflare D1 can hang instead of rejecting when a
/// JS BigInt reaches `D1PreparedStatement.bind(...)`.
extern "js" fn d1_bind_int64(value : Int64) -> @core.Any =
  #| (value) => Number(value)

///| Convert a JavaScript D1 integer cell to MoonBit Int64.
extern "js" fn d1_read_int64(value : @core.Any) -> Int64 =
  #| (value) => BigInt(Math.trunc(Number(value)))

///| Convert a JavaScript D1 integer cell to MoonBit Int.
extern "js" fn d1_read_int(value : @core.Any) -> Int =
  #| (value) => Number(value) | 0

///| Expand a sqlc.slice('name') placeholder to a comma-separated
/// list of `?` placeholders matching the slice length. An empty
/// slice expands to `NULL` so `WHERE col IN (NULL)` short-circuits
/// to no rows — saner than emitting an invalid `IN ()` clause.
fn sqlc_slice_placeholders(n : Int) -> String {
  if n <= 0 {
    return "NULL"
  }
  let buf = StringBuilder()
  for i = 0; i < n; i = i + 1 {
    if i > 0 {
      buf.write_string(",")
    }
    buf.write_string("?")
  }
  buf.to_string()
}

// Query functions
///| GetUser
/// SELECT id, name, email, created_at FROM users WHERE id = ?
pub async fn get_user(db : @cloudflare.D1Database, params : GetUserParams) -> GetUserRow? raise @cloudflare.D1Error {
  let stmt = db.prepare(get_user_sql).bind([d1_bind_int64(params.id)])
  match stmt.first() {
    None => None
    Some(result) => Some({
      id: d1_read_int64(d1_require_field(result, "id")),
      name: d1_require_field(result, "name").cast(),
      email: d1_require_field(result, "email").cast(),
      created_at: d1_require_field(result, "created_at").cast(),
    })
  }
}

///| ListUsers
/// SELECT id, name, email, created_at FROM users ORDER BY name
pub async fn list_users(db : @cloudflare.D1Database) -> Array[ListUsersRow] raise @cloudflare.D1Error {
  let stmt = db.prepare(list_users_sql)
  let d1_result = stmt.all()
  let results_arr = d1_result.get_results()
  let results : Array[ListUsersRow] = []
  for row in results_arr {
    results.push({
      id: d1_read_int64(d1_require_field(row, "id")),
      name: d1_require_field(row, "name").cast(),
      email: d1_require_field(row, "email").cast(),
      created_at: d1_require_field(row, "created_at").cast(),
    })
  }
  results
}

///| CreateUser
/// INSERT INTO users (name, email) VALUES (?, ?)
pub async fn create_user(db : @cloudflare.D1Database, params : CreateUserParams) -> Int64 raise @cloudflare.D1Error {
  let stmt = db.prepare(create_user_sql).bind([@core.any(params.name), @core.any(params.email)])
  let result = stmt.run()
  match result.meta() {
    Some(m) => m.last_row_id().unwrap_or(0).to_int64()
    None => 0L
  }
}

///| UpdateUser
/// UPDATE users SET name = ?, email = ? WHERE id = ?
pub async fn update_user(db : @cloudflare.D1Database, params : UpdateUserParams) -> Int raise @cloudflare.D1Error {
  let stmt = db.prepare(update_user_sql).bind([@core.any(params.name), @core.any(params.email), d1_bind_int64(params.id)])
  let result = stmt.run()
  match result.meta() {
    Some(m) => m.changes().unwrap_or(0)
    None => 0
  }
}

///| DeleteUser
/// DELETE FROM users WHERE id = ?
pub async fn delete_user(db : @cloudflare.D1Database, params : DeleteUserParams) -> Int raise @cloudflare.D1Error {
  let stmt = db.prepare(delete_user_sql).bind([d1_bind_int64(params.id)])
  let result = stmt.run()
  match result.meta() {
    Some(m) => m.changes().unwrap_or(0)
    None => 0
  }
}
