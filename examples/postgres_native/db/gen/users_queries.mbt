       @pghelpers.PgUUID::of_uuid(uuid_var) as &@pgclient.ToSql, //  @uuid.UUID -> uuid
       @pghelpers.PgDate::of_plain_date(date_var) as &@pgclient.ToSql, //  @time.PlainDate -> date
  ]

  client.execute(UPDATE_USER_NN_SQL, params~)
}

///| DeleteUserNN
