// D1 backend (Cloudflare Workers, js target)

///|
pub fn generate_queries_d1(
  request : @plugin.GenerateRequest,
  overrides : Array[TypeOverride],
) -> String {
  let buf = StringBuilder()
  buf.write_string("// Generated by sqlc-gen-moonbit (backend: d1)\n")
  buf.write_string("// Requires: mizchi/cloudflare\n\n")

  // Helper used by every non-nullable column read. Without this, a
  // D1 cell that is `NULL` or `undefined` would propagate into a
  // MoonBit `String` via `cast()` and only crash later at the
  // first downstream use (JSON serialisation, string concat, etc).
  // `abort` (rather than `raise @cloudflare.D1Error`) is used here
  // because `@cloudflare.D1Error` is declared `pub suberror` in an
  // upstream package and its variant constructor isn't externally
  // callable. A NULL on a NOT NULL column is a schema/DB invariant
  // violation, so aborting the request rather than asking callers
  // to handle it is a defensible default.
  buf.write_string(
    (
      #|///| Read a required (NOT NULL) column from a D1 result row.
      #|/// Aborts the request with a clear message if the cell is
      #|/// null or missing — surfacing the bad row at the read site
      #|/// instead of letting `undefined` propagate through `cast()`
      #|/// into a MoonBit value.
      #|fn d1_require_field(row : @core.Any, field : String) -> @core.Any {
      #|  let value = row[field]
      #|  if @core.is_null(value) || @core.typeof_(value) == "undefined" {
      #|    abort("D1 row missing required column \"" + field + "\"")
      #|  }
      #|  value
      #|}
      #|
      #|///| Convert MoonBit Int64 params to a JavaScript Number before
      #|/// binding. Cloudflare D1 can hang instead of rejecting when a
      #|/// JS BigInt reaches `D1PreparedStatement.bind(...)`.
      #|extern "js" fn d1_bind_int64(value : Int64) -> @core.Any =
      #|  #| (value) => Number(value)
      #|
      #|///| Convert a JavaScript D1 integer cell to MoonBit Int64.
      #|extern "js" fn d1_read_int64(value : @core.Any) -> Int64 =
      #|  #| (value) => BigInt(Math.trunc(Number(value)))
      #|
      #|///| Convert a JavaScript D1 integer cell to MoonBit Int.
      #|extern "js" fn d1_read_int(value : @core.Any) -> Int =
      #|  #| (value) => Number(value) | 0
      #|
      #|///| Expand a sqlc.slice('name') placeholder to a comma-separated
      #|/// list of `?` placeholders matching the slice length. An empty
      #|/// slice expands to `NULL` so `WHERE col IN (NULL)` short-circuits
      #|/// to no rows — saner than emitting an invalid `IN ()` clause.
      #|fn sqlc_slice_placeholders(n : Int) -> String {
      #|  if n <= 0 {
      #|    return "NULL"
      #|  }
      #|  let buf = StringBuilder()
      #|  for i = 0; i < n; i = i + 1 {
      #|    if i > 0 {
      #|      buf.write_string(",")
      #|    }
      #|    buf.write_string("?")
      #|  }
      #|  buf.to_string()
      #|}
      #|
      #|
    ),
  )

  // Generate query functions using cloudflare.mbt D1 types
  buf.write_string("// Query functions\n")
  for query in request.queries {
    generate_query_function_d1(buf, query, overrides)
  }
  buf.to_string()
}

///|
fn generate_query_function_d1(
  buf : StringBuilder,
  query : @plugin.Query,
  _overrides : Array[TypeOverride],
) -> Unit {
  let func_name = to_snake_case(query.name)
  let sql_const = to_snake_case(query.name) + "_sql"
  let row_type = to_pascal_case(query.name) + "Row"
  let param_count = query.params.length()

  // Return type with async
  let return_type = match query.cmd {
    ":one" => row_type + "?"
    ":many" => "Array[" + row_type + "]"
    ":execrows" => "Int"
    ":execlastid" => "Int64"
    _ => "Unit"
  }

  // Doc comment — preserves the original line breaks from query.sql.
  backend_write_doc_comment(buf, query)

  // Function signature - async with D1Database type from cloudflare.mbt
  // Uses @cloudflare.D1Error directly (no SqlError wrapper)
  buf.write_string("pub async fn ")
  buf.write_string(func_name)
  buf.write_string("(db : @cloudflare.D1Database")
  if param_count > 0 {
    buf.write_string(", params : ")
    buf.write_string(to_pascal_case(query.name))
    buf.write_string("Params")
  }
  buf.write_string(") -> ")
  buf.write_string(return_type)
  buf.write_string(" raise @cloudflare.D1Error {\n")

  // Detect whether any param uses `sqlc.slice('name')`. Slice params
  // require runtime SQL substitution (`/*SLICE:name*/?` -> `?,?,?`)
  // and a dynamically-built bind array; the static `bind([...])`
  // shape only works when every placeholder is scalar.
  let mut has_slice = false
  for param in query.params {
    if param.column.is_sqlc_slice {
      has_slice = true
      // The current bind-loop emits exactly one for-loop per slice
      // param and pushes the values once. If the same slice name is
      // referenced more than once in the SQL the placeholder count
      // doubles but the bind count stays at one slice-length —
      // runtime fails with "Bind parameter count" mismatch.
      // See issue #20. Fail fast at codegen time instead of letting
      // the silent runtime failure ship.
      let marker = "/*SLICE:" + param.column.name + "*/?"
      let occurrences = count_substring(query.text, marker)
      if occurrences > 1 {
        abort(
          "sqlc.slice('" +
          param.column.name +
          "') is referenced " +
          occurrences.to_string() +
          " times in query '" +
          query.name +
          "', but the current sqlc-gen-moonbit slice runtime only supports a single occurrence per query. Split the query into siblings, or rewrite the SQL so the slice appears once. (See https://github.com/mizchi/sqlc_gen_moonbit/issues/20)",
        )
      }
    }
  }
  if param_count == 0 {
    buf.write_string("  let stmt = db.prepare(")
    buf.write_string(sql_const)
    buf.write_string(")\n")
  } else if !has_slice {
    // Original static path — array literal, no dynamic SQL.
    buf.write_string("  let stmt = db.prepare(")
    buf.write_string(sql_const)
    buf.write_string(").bind([")
    for i, param in query.params {
      let col = param.column
      let param_name = if col.name.length() > 0 {
        to_snake_case(col.name)
      } else {
        "p" + param.number.to_string()
      }
      if i > 0 {
        buf.write_string(", ")
      }
      buf.write_string(d1_param_to_core_any(col, "params." + param_name))
    }
    buf.write_string("])\n")
  } else {
    // Dynamic SQL: rewrite every /*SLICE:name*/? marker before
    // calling prepare(), then push scalars + slice elements into a
    // mutable bind list in declaration order.
    buf.write_string("  let mut sql_text = ")
    buf.write_string(sql_const)
    buf.write_string("\n")
    for param in query.params {
      let col = param.column
      if col.is_sqlc_slice {
        let param_name = if col.name.length() > 0 {
          to_snake_case(col.name)
        } else {
          "p" + param.number.to_string()
        }
        // MoonBit's String::replace takes labelled `old~` / `new~`
        // args; the positional form trips type error 4086.
        buf.write_string("  sql_text = sql_text.replace(old=\"/*SLICE:")
        buf.write_string(col.name)
        buf.write_string("*/?\", new=sqlc_slice_placeholders(params.")
        buf.write_string(param_name)
        buf.write_string(".length()))\n")
      }
    }
    buf.write_string("  let bind_args : Array[@core.Any] = []\n")
    for param in query.params {
      let col = param.column
      let param_name = if col.name.length() > 0 {
        to_snake_case(col.name)
      } else {
        "p" + param.number.to_string()
      }
      if col.is_sqlc_slice {
        buf.write_string("  for slice_item in params.")
        buf.write_string(param_name)
        buf.write_string(" {\n    bind_args.push(")
        buf.write_string(d1_non_nullable_param_to_core_any(col, "slice_item"))
        buf.write_string(")\n  }\n")
      } else {
        buf.write_string("  bind_args.push(")
        buf.write_string(d1_param_to_core_any(col, "params." + param_name))
        buf.write_string(")\n")
      }
    }
    buf.write_string("  let stmt = db.prepare(sql_text).bind(bind_args)\n")
  }

  // Execute based on command type
  match query.cmd {
    ":one" => {
      buf.write_string("  match stmt.first() {\n")
      buf.write_string("    None => None\n")
      buf.write_string("    Some(result) => Some({\n")
      for col in query.columns {
        buf.write_string("      ")
        buf.write_string(to_snake_case(col.name))
        buf.write_string(": ")
        buf.write_string(d1_column_from_core_any(col, "result"))
        buf.write_string(",\n")
      }
      buf.write_string("    })\n")
      buf.write_string("  }\n")
    }
    ":many" => {
      buf.write_string("  let d1_result = stmt.all()\n")
      buf.write_string("  let results_arr = d1_result.get_results()\n")
      buf.write_string("  let results : Array[")
      buf.write_string(row_type)
      buf.write_string("] = []\n")
      buf.write_string("  for row in results_arr {\n")
      buf.write_string("    results.push({\n")
      for col in query.columns {
        buf.write_string("      ")
        buf.write_string(to_snake_case(col.name))
        buf.write_string(": ")
        buf.write_string(d1_column_from_core_any(col, "row"))
        buf.write_string(",\n")
      }
      buf.write_string("    })\n")
      buf.write_string("  }\n")
      buf.write_string("  results\n")
    }
    ":execrows" => {
      buf.write_string("  let result = stmt.run()\n")
      buf.write_string("  match result.meta() {\n")
      buf.write_string("    Some(m) => m.changes().unwrap_or(0)\n")
      buf.write_string("    None => 0\n")
      buf.write_string("  }\n")
    }
    ":execlastid" => {
      buf.write_string("  let result = stmt.run()\n")
      buf.write_string("  match result.meta() {\n")
      buf.write_string(
        "    Some(m) => m.last_row_id().unwrap_or(0).to_int64()\n",
      )
      buf.write_string("    None => 0L\n")
      buf.write_string("  }\n")
    }
    _ =>
      // :exec
      buf.write_string("  stmt.run() |> ignore\n")
  }
  buf.write_string("}\n\n")
}

///|
fn d1_param_to_core_any(col : @plugin.Column, expr : String) -> String {
  // For nullable types, we need to handle Option
  let is_nullable = !col.not_null
  if is_nullable {
    // For nullable params, use match to handle None - @core.null() for null value
    "(match " +
    expr +
    " { Some(v) => " +
    d1_non_nullable_param_to_core_any(col, "v") +
    "; None => @core.null() })"
  } else {
    d1_non_nullable_param_to_core_any(col, expr)
  }
}

///|
fn d1_non_nullable_param_to_core_any(
  col : @plugin.Column,
  expr : String,
) -> String {
  let type_name = col.type_.name.to_upper()
  match type_name {
    "INTEGER" | "INT" | "INT4" | "INT8" | "BIGINT" | "SERIAL" | "BIGSERIAL" =>
      "d1_bind_int64(" + expr + ")"
    "INT2" | "SMALLINT" => "@core.any(" + expr + ")"
    "REAL" | "FLOAT" | "DOUBLE" | "NUMERIC" | "DECIMAL" =>
      "@core.any(" + expr + ")"
    "TEXT" | "VARCHAR" | "CHAR" | "CHARACTER" | "CLOB" =>
      "@core.any(" + expr + ")"
    "BOOLEAN" | "BOOL" => "@core.any(" + expr + ")"
    _ => "@core.any(" + expr + ".to_string())"
  }
}

///|
fn d1_column_from_core_any(col : @plugin.Column, obj_expr : String) -> String {
  let type_name = col.type_.name.to_upper()
  let field_name = "\"" + col.name + "\""
  let field_access = obj_expr + "[" + field_name + "]"

  // Handle nullable columns
  if !col.not_null {
    // For nullable columns, check for null/undefined first
    match type_name {
      "INTEGER" | "INT" | "INT4" =>
        "(if @core.is_null(" +
        field_access +
        ") || @core.typeof_(" +
        field_access +
        ") == \"undefined\" { None } else { Some(d1_read_int64(" +
        field_access +
        ")) })"
      "SMALLINT" =>
        "(if @core.is_null(" +
        field_access +
        ") || @core.typeof_(" +
        field_access +
        ") == \"undefined\" { None } else { Some(d1_read_int(" +
        field_access +
        ")) })"
      "INT8" | "BIGINT" =>
        "(if @core.is_null(" +
        field_access +
        ") || @core.typeof_(" +
        field_access +
        ") == \"undefined\" { None } else { Some(d1_read_int64(" +
        field_access +
        ")) })"
      _ =>
        "(if @core.is_null(" +
        field_access +
        ") || @core.typeof_(" +
        field_access +
        ") == \"undefined\" { None } else { Some(" +
        field_access +
        ".cast()) })"
    }
  } else {
    // Non-nullable columns route through `d1_require_field` so a
    // NULL or missing cell raises a D1Error at the read site rather
    // than leaking `undefined` into a MoonBit value via `cast()`.
    let required = "d1_require_field(" + obj_expr + ", " + field_name + ")"
    match type_name {
      // D1/SQLite returns JavaScript numbers; generated local helpers
      // convert them to MoonBit integer values for the active JS target.
      // For smaller integer types (INTEGER, INT, INT4, SMALLINT), convert to Int
      "INTEGER" | "INT" | "INT4" => "d1_read_int64(" + required + ")"
      "SMALLINT" => "d1_read_int(" + required + ")"
      "INT8" | "BIGINT" => "d1_read_int64(" + required + ")"
      "REAL" | "FLOAT" | "DOUBLE" | "NUMERIC" | "DECIMAL" =>
        required + ".cast()"
      "TEXT" | "VARCHAR" | "CHAR" | "CHARACTER" | "CLOB" => required + ".cast()"
      "BOOLEAN" | "BOOL" => required + ".cast()"
      _ => required + ".cast()"
    }
  }
}
